<Layouts.app flash={@flash}>
  <script :type={Phoenix.LiveView.ColocatedHook} name=".ShareHandler">
    export default {
      mounted() {
        this.handleEvent("copy_url", ({ url }) => {
          navigator.clipboard.writeText(url)
            .then(() => this.pushEvent("copied_to_clipboard"))
            .catch(() => {});
        });
        this.handleEvent("select_input", ({ id }) => {
          const input = document.getElementById(id);
          if (input) {
            input.select();
          }
        });
      }
    }
  </script>

  <%!-- Mounts the .ShareHandler hook so copy/select events are received --%>
  <div id="share-handler" phx-hook=".ShareHandler" class="hidden" />

  <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="flex size-12 items-center justify-center rounded-pill border border-border bg-surface-2">
        <.icon name="hero-at-symbol" class="size-5 text-text-muted" />
      </div>
      <div>
        <h1 class="font-display text-h3 font-bold text-text">{@handle}</h1>
        <p class="text-small text-text-faint">MBTI Analysis</p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <%= if @is_expired do %>
        <span class="flex items-center gap-1.5 rounded-pill border border-border bg-surface-2 px-3 py-2 text-badge text-text-faint">
          <.icon name="hero-clock" class="size-4" /> Cache expired
        </span>
      <% end %>

      <button
        phx-click="regenerate"
        disabled={@is_regenerating}
        class="inline-flex items-center gap-2 rounded-pill bg-text px-4 py-2 text-small font-bold text-canvas transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
      >
        <.icon
          name="hero-arrow-path"
          class={["size-4", @is_regenerating && "motion-safe:animate-spin"]}
        />
        <span class="hidden sm:inline">Regenerate</span>
      </button>

      <.link
        navigate={~p"/"}
        class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface-2 px-4 py-2 text-small font-bold text-text transition-colors hover:bg-surface-3"
      >
        <.icon name="hero-home" class="size-4" />
        <span class="hidden sm:inline">New</span>
      </.link>
    </div>
  </div>

  <.async_result :let={result} assign={@result}>
    <:loading>
      <.result_loading id="result-loading" />
    </:loading>

    <:failed :let={failure}>
      <.result_error id="result-error" message={elem(failure, 1)} />
    </:failed>

    <div :if={@mbti_info != nil} class="space-y-16 py-8 md:py-12">
      <.type_hero
        id="result-type-hero"
        type={result["type"]}
        type_name={@mbti_info.name}
        group_label={@mbti_info.group_label}
        description={@mbti_info.description}
      />

      <section id="result-section-dimensions" phx-hook="RevealOnScroll" class="space-y-4">
        <h3 class="text-badge font-bold uppercase tracking-[0.2em] text-text-faint">
          Dimensions
        </h3>
        <.dimension_grid
          id="result-dimensions"
          dimensions={@mbti_info.dimensions}
        />
      </section>

      <section id="result-section-traits" phx-hook="RevealOnScroll" class="space-y-4">
        <h3 class="text-badge font-bold uppercase tracking-[0.2em] text-text-faint">
          Key Traits
        </h3>
        <.traits_list
          id="result-traits"
          traits={@mbti_info.traits}
        />
      </section>

      <div
        id="result-section-strengths"
        phx-hook="RevealOnScroll"
        class="grid gap-6 md:grid-cols-2"
      >
        <section class="space-y-4 rounded-xl border border-border bg-surface-2 p-6">
          <h3 class="flex items-center gap-2 text-badge font-bold uppercase tracking-[0.2em] text-text-faint">
            <.icon name="hero-check-circle" class="size-4 text-[var(--type-accent)]" /> Strengths
          </h3>
          <ul class="space-y-2">
            <li :for={strength <- @mbti_info.strengths} class="flex items-start gap-2">
              <.icon
                name="hero-chevron-right"
                class="mt-0.5 size-4 shrink-0 text-[var(--type-accent)]"
              />
              <span class="text-body-l text-text">{strength}</span>
            </li>
          </ul>
        </section>

        <section class="space-y-4 rounded-xl border border-border bg-surface-2 p-6">
          <h3 class="flex items-center gap-2 text-badge font-bold uppercase tracking-[0.2em] text-text-faint">
            <.icon name="hero-x-circle" class="size-4 text-text-faint" /> Growth Areas
          </h3>
          <ul class="space-y-2">
            <li :for={weakness <- @mbti_info.weaknesses} class="flex items-start gap-2">
              <.icon name="hero-chevron-right" class="mt-0.5 size-4 shrink-0 text-text-faint" />
              <span class="text-body-l text-text">{weakness}</span>
            </li>
          </ul>
        </section>
      </div>

      <section id="result-section-famous" phx-hook="RevealOnScroll" class="space-y-4">
        <h3 class="text-badge font-bold uppercase tracking-[0.2em] text-text-faint">
          Famous {@mbti_info.name}s
        </h3>
        <.famous_people
          id="result-famous"
          people={@mbti_info.famous_people}
        />
      </section>

      <section id="result-section-careers" phx-hook="RevealOnScroll" class="space-y-4">
        <h3 class="text-badge font-bold uppercase tracking-[0.2em] text-text-faint">
          Well-Suited Careers
        </h3>
        <.careers_list id="result-careers" careers={@mbti_info.careers} />
      </section>

      <.ai_reason
        id="result-reason"
        reason={result["reason"]}
      />

      <section id="result-section-share" phx-hook="RevealOnScroll" class="space-y-4">
        <h3 class="text-badge font-bold uppercase tracking-[0.2em] text-text-faint">
          Share This Result
        </h3>
        <.share_bar id="result-share" share_url={@share_url} />
      </section>
    </div>
  </.async_result>
</Layouts.app>
