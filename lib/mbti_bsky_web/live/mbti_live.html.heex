<Layouts.app flash={@flash}>
  <div :if={!@result.loading} style="--type-accent: var(--type-intj)">
    <.result_empty id="home-empty">
      <.search_input id="home-search" placeholder="your-handle.bsky.social" />
    </.result_empty>
  </div>

  <.async_result assign={@result}>
    <:loading>
      <.result_loading id="home-loading" />
    </:loading>

    <:failed :let={failure}>
      <.result_error id="home-error" message={elem(failure, 1)} />
    </:failed>
  </.async_result>
</Layouts.app>
